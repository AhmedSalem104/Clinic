{
  "name": "clinic-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Modular clinic management system for a multi-doctor women's health clinic.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:css": "tailwindcss -i ./styles/tailwind.css -o ./public/css/tailwind.css --minify",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:ensure-booking-ready": "node scripts/ensure-active-doctor-booking.js",
    "test": "node --test",
    "check": "node --check server.js && node --check src/app.js",
    "qa:gate": "node scripts/qa-gate.js",
    "qa:gate:fast": "node scripts/qa-gate.js --skip-tests",
    "qa:gate:json": "node scripts/qa-gate.js --json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mssql": "^11.0.1",
    "multer": "^1.4.5-lts.1",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "tailwindcss": "^3.4.17"
  }
}
