NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
TRUST_PROXY_HOPS=1
CLINIC_TIME_ZONE=Africa/Cairo
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_MAX_AGE_MS=28800000
DB_SERVER=your-sql-server-host
DB_DATABASE=your-database
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
DB_MULTIPLE_ACTIVE_RESULT_SETS=true
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=15000
UPLOAD_DIR=storage/uploads
# local is for non-serverless development only. Configure a durable object/file
# storage adapter before enabling medical document uploads on Vercel.
FILE_STORAGE_PROVIDER=local
MAX_UPLOAD_BYTES=10485760
REVERSE_GEOCODER_URL=https://nominatim.openstreetmap.org/reverse
REVERSE_GEOCODER_USER_AGENT=ClinicManagementSystem/1.0
LOG_LEVEL=info
SEED_OWNER_EMAIL=owner@clinic.local
SEED_OWNER_PASSWORD=ChangeMe!123
SEED_DOCTOR_PASSWORD=ChangeMe!123
SEED_RECEPTION_PASSWORD=ChangeMe!123
